# Copy this file to .env.local. Never commit real AWS credentials.
OVERDARE_STUDIO_S3_BUCKET=ovdr-build-binary
OVERDARE_STUDIO_S3_REGION=ap-northeast-2
OVERDARE_STUDIO_S3_PREFIX=Sandbox/Windows/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN is required only for temporary AWS credentials.
AWS_SESSION_TOKEN=

# Optional in S3 mode. When set, the downloaded latest archive must match it.
OVERDARE_STUDIO_SHA256=
# Studio currently listens on this default RPC port.
OVERDARE_STUDIO_RPC_PORT=13377
# Optional extra Studio launch arguments. The runner always supplies -OpenMap for its bundled Baseplate fixture.
# Available placeholders: {projectDir}, {projectMap}, {rpcPort}, {logDir}, and {userDataDir}.
OVERDARE_STUDIO_ARGS_JSON=[]
