# ===========================================================================
# diligent .env 템플릿 — 이 파일을 .env / .env.local 로 복사해 값을 채운다.
# (.env.local 은 .gitignore 로 무시됨. 비밀값은 .env.local 에만 넣을 것)
#
# 표기: [필수]  실행에 사실상 필요   /   [선택]  생략 가능 (기본값 명시)
# 강한 의미의 "필수" env 는 없다. 단, AI 를 돌리려면 provider 키가 하나는 있어야 한다
# (아래 키 대신 앱 UI의 Config → AI connection / keychain 으로 연결해도 됨).
# ===========================================================================

# --- AI provider 키 ---------------------------------------------------------
# [필수(택1)] 쓰는 모델에 맞는 키 하나 이상. (UI/keychain 으로 연결 시 생략 가능)
# 기본값: 없음 (미설정 시 해당 provider 사용 불가)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ZAI_API_KEY=
GEMINI_API_KEY=

# 참고: 사용할 "모델"은 env 가 아니라 config.jsonc 의 "model" 필드(또는 UI)로 지정.
#       예: .overdare/config.jsonc → { "model": "gpt-5.5" }

# --- OVERDARE Studio 연동 (cross-machine dev) -------------------------------
# 자세한 내용: docs/guide/mac-agent-windows-studio.md
# [선택] Studio RPC 호스트. 다른 머신(Windows)의 Studio에 붙을 때 그 IP.
#        기본값: localhost
STUDIO_HOST=
# [선택] Studio RPC 포트.  기본값: 13377
STUDIO_PORT=
# [선택] Mac에 마운트된 Studio 프로젝트 폴더 경로. 편집하려면 필요(미지정 시 browse만).
#   - Mac 경로를 넣는다(Windows C:\... 아님). 그 폴더 "바로 아래"에 .umap 1개가 있어야 함
#     (편집 도구가 cwd 직속의 .umap 을 찾는다). 확인: find <경로> -maxdepth 2 -iname '*.umap'
#   - 값 = 실제로 마운트한 경로:
#       · Finder(Cmd+K, smb://...) → 자동으로 /Volumes/<공유이름> (위치·이름 못 고름)
#       · mount_smbfs //user@host/share ~/mnt/studio → 원하는 경로 지정 가능
#   - 절대경로로 적는다(~ 금지). 예: /Volumes/sssss  또는  /Users/me/mnt/studio
#        기본값: 없음 → cwd=repo (browse만 가능, 편집 불가)
STUDIO_PROJECT_DIR=

# --- OVERDARE 프로젝트/허브 --------------------------------------------------
# [선택] analytics 태깅용 OVERDARE 플랫폼 프로젝트 ID (월드/레벨 이름 아님).
#        편집/browse 등 실제 도구 동작과 무관. 로컬 dev 는 비워도 무방.
#        기본값: 없음(빈 문자열)
OVERDARE_PROJECT_ID=
# [선택] hub 토큰/퍼블리시 계열 도구에서 사용.  기본값: 없음 (해당 도구만 비활성)
HUB_DOMAIN=

# --- 스토리지 / 환경 ---------------------------------------------------------
# [선택] 스토어 폴더명(.<namespace>/ 에 skills·sessions·config 저장).
#        'diligent' = 범용 런타임 기본(브랜드 중립), 'overdare' = OVERDARE 브랜딩.
#        OVERDARE sidecar/exe 는 실행 시 overdare(exe dev=overdare-dev)로 자동 보정하므로
#        보통은 설정할 필요 없다. 다른 namespace 로 강제하고 싶을 때만 지정.
#        기본값: OVERDARE 앱 'overdare' / 순수 diligent 런타임(예: 일반 CLI) 'diligent'
# DILIGENT_STORAGE_NAMESPACE=overdare
# [선택] 런타임/릴리스 환경. 정확히 "dev" 일 때만 dev, 그 외 전부 prod.
#        기본값: prod
# DILIGENT_ENV=dev

# --- 외부 도구 경로 ----------------------------------------------------------
# [선택] ripgrep 바이너리.  기본값: "rg" (PATH 에서 탐색)
# DILIGENT_RG_PATH=/usr/local/bin/rg
# [선택] luau-lsp 바이너리.  기본값: 번들된 luau-lsp → 없으면 PATH 의 "luau-lsp"
# LUAU_LSP_PATH=/usr/local/bin/luau-lsp
# [선택] OVERDARE 타입 정의(.d.lua).  기본값: 번들된 overdare-types.d.lua
# OVERDARE_TYPES_PATH=/path/to/overdare-types.d.lua

# --- 로깅 / 디버그 -----------------------------------------------------------
# [선택] 백엔드 로그 파일 경로.  기본값: 없음 (파일 로깅 안 함)
# DILIGENT_WEB_LOG_FILE=/tmp/diligent-web.log
# [선택] "1" 이면 Anthropic 요청 본문 로깅.  기본값: off
# ANTHROPIC_DEBUG_REQUEST=1
# [선택] "1" 이면 디버그용 web 도구 활성화.  기본값: off
# DILIGENT_DEBUG_WEB_TOOLS=1
# [선택] analytics 엔드포인트 override.  기본값: 없음 (config 또는 기본 bubo 호스트 사용)
# DILIGENT_ANALYTICS_URL=

# --- TUI 튜닝 ----------------------------------------------------------------
# [선택] 최대 프레임레이트.  기본값: 30
# DILIGENT_TUI_MAX_FPS=30
# [선택] 스트리밍 출력 배치 간격(ms, 최소 16).  기본값: 16
# DILIGENT_TUI_STREAM_BATCH_MS=16

# --- 프론트엔드(Vite) --------------------------------------------------------
# [선택] 웹 UI 브랜딩 — 페이지 <title> + 앱 로고 텍스트(APP_PROJECT_MARK).
#        Vite 빌드/실행 시 주입(VITE_ 프리픽스). 외형용이라 기능엔 영향 없음.
#        기본값: "Diligent"
# VITE_APP_PROJECT_NAME=Diligent

# --- 테스트 전용 (평소 앱 사용엔 불필요) -------------------------------------
# [선택] "1" 이면 실제 provider API 를 호출하는 라이브 E2E 테스트 실행
#        (packages/e2e/*, 해당 provider 키도 필요).  기본값: off → skip
#        예: DILIGENT_RUN_LIVE_E2E=1 bun test packages/e2e/
# DILIGENT_RUN_LIVE_E2E=1
# [선택] "true" 면 테스트 환경에서도 analytics 전송.  기본값: off (테스트 중 비전송)
# DILIGENT_ANALYTICS_ALLOW_IN_TEST=true
# [선택] 라이브 E2E 대화 테스트가 쓸 모델 (앱 모델과 무관).
#        기본값: claude-sonnet-4-20250514
# DILIGENT_E2E_MODEL=claude-opus-4-20250514
# (참고) TEST_API_KEY 등 TEST_* 는 단위 테스트가 내부에서 set/delete 하는
#        픽스처라 여기서 설정하지 않는다.
