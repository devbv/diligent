# Anthropic (required for claude-* models)
ANTHROPIC_API_KEY=

# OpenAI (required for gpt-*/o1/o3 models)
OPENAI_API_KEY=

# z.ai Coding Plan (required for glm-* models)
ZAI_CODING_PLAN_API_KEY=

