# ===========================================================================
# diligent .env template — copy this to .env / .env.local and fill in values.
# (.env.local is gitignored. Put secrets only in .env.local.)
#
# Legend: [required] effectively needed to run / [optional] can be omitted (default shown)
# No env var is strictly required. But to run the AI you need at least one
# provider key (or connect via the app UI: Config -> AI connection / keychain).
# ===========================================================================

# --- AI provider keys -------------------------------------------------------
# [required (one of)] At least one key for the model you use. (Can be omitted
# if you connect via UI/keychain.)
# Default: none (provider unusable if unset)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ZAI_API_KEY=
GEMINI_API_KEY=

# Note: the "model" is set via config.jsonc "model" field (or the UI), not env.
#       e.g. .overdare/config.jsonc -> { "model": "gpt-5.5" }

# --- OVERDARE Studio integration (cross-machine dev) ------------------------
# More detail: docs/guide/mac-agent-windows-studio.md
# [optional] Studio RPC host. The IP when connecting to a Studio on another
#            machine (Windows). Default: localhost
STUDIO_HOST=
# [optional] Studio RPC port. Default: 13377
STUDIO_PORT=
# [optional] Path to the Studio project folder mounted on the Mac. Needed for
#            editing (browse-only if unset).
#   - Use a Mac path (not a Windows C:\... path). The folder must contain
#     exactly one .umap directly inside it (the edit tools look for the .umap
#     right under cwd). Check: find <path> -maxdepth 2 -iname '*.umap'
#   - The value is wherever you actually mounted it:
#       * Finder (Cmd+K, smb://...) -> auto-mounts to /Volumes/<share> (path
#         and name not choosable)
#       * mount_smbfs //user@host/share ~/mnt/studio -> you pick the path
#   - Use an absolute path (no ~). e.g. /Volumes/sssss or /Users/me/mnt/studio
#   Default: none -> cwd=repo (browse only, no editing)
STUDIO_PROJECT_DIR=

# --- OVERDARE project / hub -------------------------------------------------
# [optional] OVERDARE platform project ID used for analytics tagging (NOT a
#            world/level name). Unrelated to actual tool behavior (edit/browse).
#            Safe to leave empty for local dev. Default: none (empty string)
OVERDARE_PROJECT_ID=
# [optional] Used by hub-token / publish-family tools. Default: none (only
#            those tools are disabled)
HUB_DOMAIN=

# --- Storage / environment --------------------------------------------------
# [optional] Store folder name (.<namespace>/ holds skills, sessions, config).
#            'diligent' = generic runtime default (brand-neutral),
#            'overdare' = OVERDARE branding.
#            The OVERDARE sidecar/exe auto-corrects this to overdare (exe dev =
#            overdare-dev) at startup, so you usually do not need to set it.
#            Set it only to force a different namespace.
#            Default: OVERDARE app 'overdare' / plain diligent runtime
#            (e.g. the generic CLI) 'diligent'
# DILIGENT_STORAGE_NAMESPACE=overdare
# [optional] Runtime/release environment. dev only when exactly "dev",
#            everything else is prod. Default: prod
# DILIGENT_ENV=dev

# --- External tool paths ----------------------------------------------------
# [optional] ripgrep binary. Default: "rg" (looked up on PATH)
# DILIGENT_RG_PATH=/usr/local/bin/rg
# [optional] luau-lsp binary. Default: bundled luau-lsp -> else "luau-lsp" on PATH
# LUAU_LSP_PATH=/usr/local/bin/luau-lsp
# [optional] OVERDARE type definitions (.d.lua). Default: bundled overdare-types.d.lua
# OVERDARE_TYPES_PATH=/path/to/overdare-types.d.lua

# --- Logging / debug --------------------------------------------------------
# [optional] Backend log file path. Default: none (no file logging)
# DILIGENT_WEB_LOG_FILE=/tmp/diligent-web.log
# [optional] "1" logs Anthropic request bodies. Default: off
# ANTHROPIC_DEBUG_REQUEST=1
# [optional] "1" enables debug web tools. Default: off
# DILIGENT_DEBUG_WEB_TOOLS=1
# [optional] Override the analytics endpoint. Default: none (uses config or the
#            default bubo host)
# DILIGENT_ANALYTICS_URL=

# --- TUI tuning -------------------------------------------------------------
# [optional] Max frame rate. Default: 30
# DILIGENT_TUI_MAX_FPS=30
# [optional] Streaming output batch interval (ms, min 16). Default: 16
# DILIGENT_TUI_STREAM_BATCH_MS=16

# --- Frontend (Vite) --------------------------------------------------------
# [optional] Web UI branding — page <title> + app logo text (APP_PROJECT_MARK).
#            Injected at Vite build/run time (VITE_ prefix). Cosmetic only,
#            no functional effect. Default: "Diligent"
# VITE_APP_PROJECT_NAME=Diligent

# --- Test-only (not needed for normal app use) ------------------------------
# [optional] "1" runs the live E2E tests that hit real provider APIs
#            (packages/e2e/*, also needs the relevant provider key).
#            Default: off -> skipped
#            e.g. DILIGENT_RUN_LIVE_E2E=1 bun test packages/e2e/
# DILIGENT_RUN_LIVE_E2E=1
# [optional] "true" allows analytics to be sent even in tests.
#            Default: off (not sent during tests)
# DILIGENT_ANALYTICS_ALLOW_IN_TEST=true
# [optional] Model used by the live E2E conversation test (unrelated to the app
#            model). Default: claude-sonnet-4-20250514
# DILIGENT_E2E_MODEL=claude-opus-4-20250514
# (Note) TEST_API_KEY and other TEST_* vars are fixtures that unit tests
#        set/delete internally, so they are not configured here.
