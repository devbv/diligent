{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@diligent/logging": ["packages/logging/src/index.ts"],
      "@diligent/logging/*": ["packages/logging/src/*"],
      "@diligent/core": ["packages/core/src/index.ts"],
      "@diligent/core/compaction-contract": ["packages/core/src/contracts/compaction.ts"],
      "@diligent/core/image-contract": ["packages/core/src/contracts/image.ts"],
      "@diligent/core/message-contract": ["packages/core/src/contracts/message.ts"],
      "@diligent/core/prompt-contract": ["packages/core/src/contracts/prompt.ts"],
      "@diligent/core/provider-contract": ["packages/core/src/contracts/provider.ts"],
      "@diligent/core/tool-contract": ["packages/core/src/contracts/tool.ts"],
      "@diligent/core/*": ["packages/core/src/*"],
      "@diligent/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@diligent/plugin-sdk/*": ["packages/plugin-sdk/src/*"],
      "@diligent/runtime": ["packages/runtime/src/index.ts"],
      "@diligent/runtime/client": ["packages/runtime/src/client.ts"],
      "@diligent/runtime/*": ["packages/runtime/src/*"],
      "@diligent/protocol": ["packages/protocol/src/index.ts"],
      "@diligent/protocol/*": ["packages/protocol/src/*"]
    }
  },
  "include": []
}
